[workspace]
resolver = "2"

members = [
    "client/ona-core",
    "shell/src-tauri"
]

[workspace.package]
version = "0.1.0-alpha"
edition = "2021"
authors = ["ONA Gaming Studio"]

[workspace.dependencies]
tokio = { version = "1", features = ["full"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"