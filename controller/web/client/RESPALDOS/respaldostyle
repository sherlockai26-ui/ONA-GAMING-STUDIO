* {
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
}

html,
body {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;

    overflow: hidden;

    background: #02050a;

    font-family: Arial, Helvetica, sans-serif;

    touch-action: none;
    overscroll-behavior: none;

    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
}

body {
    position: fixed;

    width: 100%;
    height: 100%;

    touch-action: none;

    overscroll-behavior: none;
}

/* =========================
CONTENEDOR PRINCIPAL
========================= */

#controller {
    position: fixed;

    inset: 0;

    width: 100vw;
    height: 100dvh;

    overflow: hidden;

    touch-action: none;

    background:
        radial-gradient(
            circle at 50% 50%,
            rgba(25, 70, 120, 0.18),
            transparent 45%
        ),
        linear-gradient(
            135deg,
            #02050a 0%,
            #07111d 50%,
            #02050a 100%
        );
}

/* =========================
BARRA SUPERIOR
========================= */

.top-bar {
    position: absolute;

    top: 0;
    left: 0;
    right: 0;

    height: 20%;

    display: flex;

    align-items: flex-start;
    justify-content: space-between;

    padding:
        max(8px, env(safe-area-inset-top))
        max(14px, env(safe-area-inset-right))
        0
        max(14px, env(safe-area-inset-left));

    touch-action: none;
}

/* =========================
LOGO
========================= */

.ona-logo {
    position: absolute;

    top: max(8px, env(safe-area-inset-top));
    left: 50%;

    transform: translateX(-50%);

    color: #eaf6ff;

    font-size: clamp(20px, 4vw, 34px);

    font-weight: 300;

    letter-spacing: 5px;

    text-shadow:
        0 0 8px rgba(80, 180, 255, 0.5),
        0 0 20px rgba(30, 130, 255, 0.25);

    pointer-events: none;
}

.ona-logo span {
    opacity: 0.7;
}

/* =========================
L1 L2 R1 R2
========================= */

.shoulder {
    width: clamp(52px, 9vw, 82px);
    height: clamp(30px, 6vw, 44px);

    border: 1px solid rgba(170, 210, 240, 0.3);

    border-radius: 12px;

    background:
        linear-gradient(
            180deg,
            rgba(160, 190, 215, 0.20),
            rgba(40, 60, 80, 0.35)
        );

    color: rgba(230, 245, 255, 0.85);

    font-size: clamp(10px, 1.8vw, 14px);

    box-shadow:
        inset 0 1px 2px rgba(255,255,255,0.25),
        0 4px 12px rgba(0,0,0,0.35);

    touch-action: manipulation;

    -webkit-user-select: none;
    user-select: none;
}

.l2,
.r2 {
    margin-left: -10px;
}

/* =========================
SELECT / START
========================= */

.system-buttons {
    position: absolute;

    top: 48px;
    left: 50%;

    transform: translateX(-50%);

    display: flex;

    gap: 8px;

    touch-action: none;
}

.system-button {
    min-width: 60px;
    height: 24px;

    border-radius: 14px;

    border: 1px solid rgba(180,220,245,0.25);

    background: rgba(80,110,140,0.25);

    color: rgba(220,235,245,0.8);

    font-size: 9px;

    letter-spacing: 0.5px;

    touch-action: manipulation;
}

/* =========================
JOYSTICK
========================= */

.left-control {
    position: absolute;

    left: 4%;
    bottom: 5%;

    width: 38%;
    height: 70%;

    touch-action: none;
}

#joystick-zone {
    position: absolute;

    left: 50%;
    top: 50%;

    transform: translate(-50%, -50%);

    width: min(190px, 28vw, 48vh);

    aspect-ratio: 1;

    border-radius: 50%;

    border: 1px solid rgba(150,210,255,0.18);

    background:
        radial-gradient(
            circle,
            rgba(50,110,170,0.08),
            rgba(5,15,25,0.15)
        );

    box-shadow:
        inset 0 0 25px rgba(80,160,255,0.08),
        0 0 20px rgba(0,120,255,0.08);

    touch-action: none;
}

#joystick {
    position: absolute;

    left: 50%;
    top: 50%;

    width: 45%;

    aspect-ratio: 1;

    transform: translate(-50%, -50%);

    border-radius: 50%;

    background:
        radial-gradient(
            circle at 35% 30%,
            rgba(180,225,255,0.95),
            rgba(45,110,180,0.85) 45%,
            rgba(5,30,60,0.95) 100%
        );

    border: 2px solid rgba(140,210,255,0.65);

    box-shadow:
        0 0 12px rgba(30,150,255,0.8),
        0 0 35px rgba(20,100,255,0.35),
        inset 0 0 18px rgba(255,255,255,0.18);

    transition: transform 0.05s linear;

    touch-action: none;
}

.joystick-core {
    position: absolute;

    left: 50%;
    top: 50%;

    width: 45%;

    aspect-ratio: 1;

    transform: translate(-50%, -50%);

    border-radius: 50%;

    background: rgba(210,240,255,0.75);

    box-shadow:
        0 0 15px rgba(120,210,255,0.8);

    pointer-events: none;
}

/* =========================
BOTONES A B X Y
========================= */

.right-control {
    position: absolute;

    right: 4%;
    bottom: 5%;

    width: 40%;
    height: 72%;

    touch-action: none;
}

.action-button {
    position: absolute;

    width: min(82px, 12vw, 20vh);

    aspect-ratio: 1;

    border-radius: 50%;

    border: 1px solid rgba(210,235,255,0.45);

    color: white;

    font-size: clamp(16px, 3vw, 26px);

    font-weight: 600;

    background:
        radial-gradient(
            circle at 35% 25%,
            rgba(230,245,255,0.5),
            rgba(90,120,150,0.3) 45%,
            rgba(20,30,45,0.6)
        );

    backdrop-filter: blur(8px);

    box-shadow:
        inset 0 2px 4px rgba(255,255,255,0.25),
        0 8px 20px rgba(0,0,0,0.4);

    transition:
        transform 0.08s,
        box-shadow 0.08s;

    touch-action: manipulation;

    -webkit-user-select: none;
    user-select: none;
}

/* =========================
POSICIÓN BOTONES
========================= */

.button-y {
    top: 0;
    left: 50%;

    transform: translateX(-50%);
}

.button-x {
    top: 33%;
    left: 8%;
}

.button-b {
    top: 33%;
    right: 8%;
}

.button-a {
    top: 66%;
    left: 50%;

    transform: translateX(-50%);
}

/* =========================
PRESIONADO
========================= */

.action-button:active,
.shoulder:active,
.system-button:active {
    transform: scale(0.92);

    filter: brightness(1.35);
}

.button-y:active,
.button-a:active {
    transform: translateX(-50%) scale(0.92);
}

/* =========================
HORIZONTAL
========================= */

@media (orientation: landscape) {

    #controller {
        width: 100vw;
        height: 100dvh;
    }
}

/* =========================
PANTALLAS MUY BAJAS
========================= */

@media (max-height: 400px) {

    .top-bar {
        height: 18%;
    }

    .system-buttons {
        top: 38px;
    }

    .left-control {
        bottom: 3%;
        height: 76%;
    }

    .right-control {
        bottom: 3%;
        height: 78%;
    }

    #joystick-zone {
        width: min(155px, 25vw, 48vh);
    }

    .action-button {
        width: min(68px, 11vw, 18vh);
    }
}

/* =========================
PANTALLA COMPLETA / SAFE AREA
========================= */

@supports (height: 100dvh) {

    html,
    body {
        height: 100dvh;
    }
}