{
    "$schema": "https://schema.tauri.app/config/2",

    "productName": "ONA Gaming Studio",

    "version": "0.1.0",

    "identifier": "com.ona.gamingstudio",

    "build": {
        "frontendDist": "../src"
    },

    "app": {

        "withGlobalTauri": true,

        "windows": [
            {
                "label": "main",

                "title": "ONA Gaming Studio",

                "fullscreen": true,

                "decorations": false,

                "resizable": false,

                "center": true,

                "backgroundColor": "#02050a"

            }
        ],

        "security": {
            "csp": null
        }

    },

    "bundle": {

        "active": true,

        "targets": "all",

        "icon": [
            "icons/16x16.png",
            "icons/24x24.png",
            "icons/32x32.png",
            "icons/48x48.png",
            "icons/64x64.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]

    }

}
